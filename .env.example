# ============================================================
# zotero-auto-collector 配置模板
# 复制为 .env 并填写。.env 含密钥，永远不要提交进 git！
# ============================================================

# --- Zotero（必填）---
# userID：登录 zotero.org/settings/keys，页面顶部 "Your userID for use in API calls is XXXXX"
ZOTERO_USER_ID=1234567
# API Key：同页面 Create New Private Key，勾选 Allow library access + Allow write access
ZOTERO_API_KEY=你的24位Key

# --- 采集通道（至少配 1 个，可配任意多个）---
# 每个通道 = 一组关键词 + 一个写入目标。格式：CHANNEL_<编号>_NAME/_KEYWORDS/_TARGET
# TARGET 取值：user = 你的个人库；group:<GroupID> = 指定群组库（群组ID见组设置页地址栏）

# 通道1：写入个人库
CHANNEL_1_NAME=main
CHANNEL_1_KEYWORDS=graph neural network, federated learning
CHANNEL_1_TARGET=user

# 通道2：写入群组库（与协作伙伴共享，需在 zotero.org 给 API Key 授权该群组）
# CHANNEL_2_NAME=lab
# CHANNEL_2_KEYWORDS=skin potential, mechanotransduction
# CHANNEL_2_TARGET=group:1234567

# --- 可选 ---
# OpenAlex 礼貌池联系邮箱（进了礼貌池限速更宽，建议填真实邮箱）
# OPENALEX_MAILTO=you@example.com
